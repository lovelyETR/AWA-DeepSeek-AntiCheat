<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CheatSimulator</AssemblyName>
    <RootNamespace>CheatSimulator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Company>DSH</Company>
    <Product>DeepSeekAntiCheat 作弊行为模拟器</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- 复用插件源码，保证模拟器测的就是插件里跑的那份代码 -->
  <ItemGroup>
    <Compile Include="..\DeepSeekAntiCheat\Config.cs" />
    <Compile Include="..\DeepSeekAntiCheat\Punishment.cs" />
    <Compile Include="..\DeepSeekAntiCheat\ServerFeatures.cs" />
    <Compile Include="..\DeepSeekAntiCheat\PlayerStats.cs" />
    <Compile Include="..\DeepSeekAntiCheat\Heuristics.cs" />
    <Compile Include="..\DeepSeekAntiCheat\DeepSeekClient.cs" />
    <Compile Include="..\DeepSeekAntiCheat\Scenarios.cs" />
    <Compile Include="..\DeepSeekAntiCheat\AdminTools.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Exiled.API">
      <HintPath>..\exiled\Exiled.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
